# ReelKar Environment Variables

# Google Gemini API Key (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional webhook URL for feedback submissions (e.g. Slack/Discord/Make/Zapier)
FEEDBACK_WEBHOOK_URL=
